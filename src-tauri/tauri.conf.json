{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NewsSphere",
  "version": "0.1.0",
  "identifier": "com.mkaafi6.newsphere",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NewsSphere",
        "url": "index.html",
        "fullscreen": true,
        "decorations": false,
        "resizable": false,
        "width": 400,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
